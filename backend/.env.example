# Production Environment Template for Ethereum Quantitative Engine
APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# Production CORS Whitelist (JSON list of allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Mandatory API Security Token in Production (enforces Bearer token authorization)
# API_AUTH_TOKEN=your-secure-random-token-here


# Database Path
DATABASE_PATH=trades.db

# Exchange Selection ('delta' or 'binance')
EXCHANGE=delta

# Delta Exchange Credentials & MCP Config
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here
DELTA_MCP_ENV=india_prod
DELTA_MCP_MODE=read

# Alerts & Webhooks (Optional)
# ALERTS__ENABLED=true
# ALERTS__WEBHOOK_URL=https://your-webhook-listener.com/alert
# ALERTS__TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# ALERTS__TELEGRAM_CHAT_ID=-1001234567890
# ALERTS__MIN_CONFIDENCE_TO_ALERT=0.55

